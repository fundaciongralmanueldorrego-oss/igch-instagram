name: Instagram — Info Gran Chaco
on:
  workflow_dispatch:
    inputs:
      mode:
        description: 'preview: no publica; publish: publica si está habilitado; demo: muestra ficticia'
        type: choice
        options: [preview, publish, demo]
        default: preview
      slug:
        description: 'Slug de una noticia concreta (opcional)'
        required: false
        type: string
  schedule:
    - cron: '13,43 * * * *'
permissions:
  contents: write
concurrency:
  group: igch-instagram
  cancel-in-progress: false
jobs:
  instagram:
    if: github.event_name == 'workflow_dispatch' || vars.IG_ENABLED == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.repository.default_branch }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Preparar dependencias y tipografía
        run: |
          python -m pip install -r requirements.txt
          mkdir -p fonts
          curl --fail --silent --show-error --location --max-time 30 'https://raw.githubusercontent.com/google/fonts/main/ofl/montserrat/Montserrat%5Bwght%5D.ttf' -o fonts/Montserrat.ttf || { rm -f fonts/Montserrat.ttf; sudo apt-get update -qq && sudo apt-get install -y fonts-lato; }
      - name: Configurar Git
        run: |
          git config user.name 'IGCH Instagram'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
      - name: Comprobar plantillas
        run: python -m unittest discover -s tests -v
      - name: Ejecutar adaptador
        env:
          MODE: ${{ github.event.inputs.mode || 'publish' }}
          SLUG: ${{ github.event.inputs.slug || '' }}
          IG_ENABLED: ${{ vars.IG_ENABLED }}
          IG_BRANCH: ${{ github.event.repository.default_branch }}
          META_PAGE_TOKEN: ${{ secrets.META_PAGE_TOKEN }}
          META_IG_ID: ${{ secrets.META_IG_ID }}
          META_GRAPH_VERSION: ${{ vars.META_GRAPH_VERSION || 'v25.0' }}
        run: python instagram.py "$MODE" --slug "$SLUG"
      - name: Descargar placas de muestra
        if: github.event_name == 'workflow_dispatch' && (inputs.mode == 'preview' || inputs.mode == 'demo')
        uses: actions/upload-artifact@v4
        with:
          name: IGCH-previsualizacion
          path: preview/
          retention-days: 7
